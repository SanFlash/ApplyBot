PORT=8000
DEBUG=false
DATABASE_URL=

AUTO_APPLY_ENABLED=false
AUTO_APPLY_MAX=3
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
RESUME_PATH=

# Primary/free job discovery provider
JOBICY_API_URL=https://jobicy.com/api/v2/remote-jobs
JOBICY_COUNT=200
ENABLE_LEGACY_SOURCES=false

# Broad live job search (optional legacy source)
JOBVETTA_API_KEY=
JOBVETTA_API_URL=https://api.jobvetta.com/v1/jobs
INDIANAPI_KEY=
INDIANAPI_URL=https://jobs.indianapi.in/jobs
THEMUSE_API_KEY=
REMOTEOK_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Direct employer ATS discovery
# Comma-separated public board/company identifiers.
GREENHOUSE_BOARDS=
LEVER_COMPANIES=

# Optional: enables Jobicy's commercial direct ATS URLs. Keep secret.
JOBICY_API_KEY=
JOBICY_TIMEOUT=30


# Indeed job discovery through RapidAPI
# Subscribe to the Indeed API on RapidAPI and set the key in Render Environment Variables.
INDEED_RAPIDAPI_ENABLED=true
INDEED_RAPIDAPI_KEY=
INDEED_RAPIDAPI_HOST=indeed-jobs-api.p.rapidapi.com
INDEED_RAPIDAPI_URL=https://indeed-jobs-api.p.rapidapi.com
INDEED_RAPIDAPI_PATH=/jobs
# 15 jobs per page. Keep these modest to respect your RapidAPI plan quota.
INDEED_MAX_PAGES=2
INDEED_MAX_QUERIES=3
# Optional: only request recent jobs (1, 3, 7, or 14 days).
INDEED_DATE_POSTED=7
# Indeed documents salaryMin/salaryMax as USD. Keep conversion off unless you configure a trusted rate.
INDEED_CONVERT_USD_SALARY=false
INDEED_USD_TO_INR=0

# Optional AI enrichment. Use "none" for zero-cost deterministic mode.
# "ollama" uses a local model with no API key. "gemini" uses the Gemini free tier when available.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3

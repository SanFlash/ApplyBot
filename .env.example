PORT=8000
DEBUG=false
DATABASE_URL=

AUTO_APPLY_ENABLED=false
AUTO_APPLY_MAX=3

# Candidate contact data stays in environment variables, never in source control.
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
RESUME_PATH=data/resume.pdf

# Free-first discovery
FREE_JOB_DATASET_ENABLED=true
FREE_JOB_DATASET_URL=https://cdn.jsdelivr.net/gh/ConorsCode/open-jobs-data@main/data/jobs.json
FREE_JOB_DATASET_TIMEOUT=25
FREE_JOB_DATASET_CACHE_SECONDS=900
REMOTEOK_ENABLED=true

# Optional legacy/public providers
JOBICY_API_URL=https://jobicy.com/api/v2/remote-jobs
JOBICY_COUNT=200
ENABLE_LEGACY_SOURCES=false
JOBVETTA_API_KEY=
JOBVETTA_API_URL=https://api.jobvetta.com/v1/jobs
INDIANAPI_KEY=
INDIANAPI_URL=https://jobs.indianapi.in/jobs
THEMUSE_API_KEY=
THEMUSE_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional Indeed provider. Official platform search handoff works without this.
INDEED_RAPIDAPI_ENABLED=false
INDEED_RAPIDAPI_KEY=
INDEED_RAPIDAPI_HOST=indeed-jobs-api.p.rapidapi.com
INDEED_RAPIDAPI_URL=https://indeed-jobs-api.p.rapidapi.com
INDEED_RAPIDAPI_PATH=/jobs
INDEED_MAX_PAGES=1
INDEED_MAX_QUERIES=2
INDEED_DATE_POSTED=7
INDEED_CONVERT_USD_SALARY=false
INDEED_USD_TO_INR=0

# Optional AI enrichment. none = deterministic/free mode.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3
